# Carregar as bibliotecas necessárias
library(readr)
library(dplyr)
library(tidyr)
library(ggplot2)
library(tidyverse)

# Ler e preparar os dados
df <- read_csv("P450_2025.csv")
names(df) <- c("TYPE", "CYP_subfamily", "A_thaliana", "I_puberulus", "S_bicolor")

# Transformar para formato longo
df_long <- df %>%
  pivot_longer(
    cols = c(A_thaliana, I_puberulus, S_bicolor),
    names_to = "Species", 
    values_to = "Count"
  )

# Heatmap com cores graduais
ggplot(df_long, aes(x = Species, y = as.factor(CYP_subfamily), fill = Count)) +
  geom_tile(color = "white", linewidth = 0.8) +
  geom_text(aes(label = ifelse(Count > 0, Count, "")), 
            color = "white", size = 2.8, fontface = "bold") +
  scale_fill_gradientn(
    colors = c("#457B9D", "#A8DADC", "#F4A261", "#E63946"),
    values = scales::rescale(c(0, 1, 10, 100)),
    na.value = "white",
    name = "Número de Genes"
  ) +
  facet_grid(TYPE ~ ., scales = "free_y", space = "free") +
  labs(
    title = "Heatmap - Famílias CYP por Espécie",
    subtitle = "A type vs Non A Type",
    x = "Espécie",
    y = "Subfamília CYP"
  ) +
  theme_minimal() +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1, size = 11, face = "bold"),
    axis.text.y = element_text(size = 7, face = "bold"),
    strip.text = element_text(face = "bold", size = 12),
    panel.grid = element_blank(),
    legend.position = "right",
    plot.title = element_text(face = "bold", size = 16, hjust = 0.5),
    plot.subtitle = element_text(size = 12, hjust = 0.5)
  )

# Heatmap com paleta de cores mais definida
ggplot(df_long, aes(x = Species, y = as.factor(CYP_subfamily), fill = Count)) +
  geom_tile(color = "white", linewidth = 0.8, width = 0.9, height = 0.9) +
  geom_text(aes(label = ifelse(Count > 0, Count, "")), 
            color = "white", size = 2.5, fontface = "bold") +
  scale_fill_gradientn(
    colors = c("#1E88E5", "#64B5F6", "#FFB74D", "#E53935", "#B71C1C"),
    values = scales::rescale(c(0, 1, 5, 20, 100)),
    name = "Número de Genes",
    breaks = c(0, 1, 5, 10, 25, 50, 100)
  ) +
  facet_grid(TYPE ~ ., scales = "free_y", space = "free") +
  labs(
    title = "Distribuição de Famílias CYP",
    subtitle = "Intensidade da cor = número de genes",
    x = "Espécie",
    y = "Subfamília CYP"
  ) +
  theme_minimal() +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1, size = 10, face = "bold"),
    axis.text.y = element_text(size = 6.5, face = "bold"),
    strip.text = element_text(face = "bold", size = 11, color = "white"),
    strip.background = element_rect(fill = "grey20"),
    panel.grid = element_blank(),
    legend.position = "right",
    plot.title = element_text(face = "bold", size = 14, hjust = 0.5)
  )

