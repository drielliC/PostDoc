#!/bin/bash

# Definir diretórios
dir="~/Pitcairnia/bismark_output_MCS"
output_dir="~/Pitcairnia/bismark_output_MCS/deduplicated_bismark"
container="/home/dcanal/SIF/bismark_v0.21.0.sif"
# Criar diretório de saída se não existir
mkdir -p $output_dir
# Navegar até o diretório de entrada
eval cd $dir
# Loop para processar todos os arquivos *trimmed_bismark_bt2_pe.bam
for bam_file in *.trimmed_bismark_bt2_pe.bam; do
    # Extrair o nome base do arquivo
    base_name="${bam_file%.trimmed_bismark_bt2_pe.bam}"
        # Rodar o comando deduplicate_bismark dentro do contêiner Singularity
    echo "Processando $bam_file..."
    singularity exec $container deduplicate_bismark --bam --paired --outfile "$output_dir/${base_name}_deduplicated" "$bam_file"
    
    echo "Finalizado: $output_dir/${base_name}_deduplicated.bam"
done

echo "Processo concluído para todos os arquivos!"
