#!/bin/bash

# Definição de diretórios
INPUT_DIR="/mnt/pesquisa/DBV/LAB-EEGP/Clarisse_Palma/Download04062024/"
OUTPUT_DIR="$HOME/Pitcairnia/trimmed_reads2"
mkdir -p "$OUTPUT_DIR"

# Número de threads
N_CORES=4

# Loop para processar todos os pares de reads
for sample in $(ls $INPUT_DIR | grep "_1.fastq.gz" | sed 's/_1.fastq.gz//'); do
    READ1="${INPUT_DIR}${sample}_1.fastq.gz"
    READ2="${INPUT_DIR}${sample}_2.fastq.gz"
    PREFIX="${OUTPUT_DIR}/${sample}"

    echo "Processando ${sample}..."

    fastp --thread $N_CORES \
          --in1 $READ1 --out1 ${PREFIX}_1.trimmed.fastq.gz \
          --in2 $READ2 --out2 ${PREFIX}_2.trimmed.fastq.gz \
          -l 35 \
          -h ${PREFIX}_PE.fastp.html \
          --cut_front --cut_front_window_size 1 --cut_front_mean_quality 10 \
          --cut_tail --cut_tail_window_size 1 --cut_tail_mean_quality 10 \
          --detect_adapter_for_pe \
          --json ${PREFIX}_fastp.json

    echo "Concluído: ${sample}"
done

echo "Todos os arquivos foram processados."

