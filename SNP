# Extrair SNPs C/T (C->T no forward strand, G->A no reverse strand)
grep -v "^##" Psta_output_variants_noindels_minQ30.recode.vcf | grep -v "^#" | 
awk '$4 == "C" && $5 == "T" {print $1"\t"$2}' > CT_SNPs.txt

# Extrair SNPs G/A (G->A no forward strand, C->T no reverse strand)
grep -v "^##" Psta_output_variants_noindels_minQ30.recode.vcf | grep -v "^#" | 
awk '$4 == "G" && $5 == "A" {print $1"\t"$2}' > GA_SNPs.txt

# Verificar quantos SNPs de cada tipo foram encontrados
echo "SNPs C/T: $(wc -l CT_SNPs.txt)"
echo "SNPs G/A: $(wc -l GA_SNPs.txt)"
