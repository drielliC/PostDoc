#!/bin/bash
#$ -q all.q
#$ -cwd
#$ -V
#$ -pe smp 15
#$ -N fastqc_teste
#$ -o fastqc.out
#$ -e fastqc.err

### Configurações do Processamento ###
THREADS=$NSLOTS
INPUT_DIR="/Storage/data2/drielli.canal/SNP"
OUTPUT_DIR="$INPUT_DIR/FastQC_Results"

### Criar diretório de resultados ###
mkdir -p "$OUTPUT_DIR"

### Análise de Qualidade com FastQC e MultiQC ###
echo "=============================================="
echo "Iniciando Análise de Qualidade em $(date)"
echo "Diretório de entrada: $INPUT_DIR"
echo "Diretório de saída: $OUTPUT_DIR"
echo "Usando $THREADS threads"
echo "=============================================="

# 1. Verificar arquivos de entrada
cd "$INPUT_DIR" || { echo "ERRO: Não foi possível acessar $INPUT_DIR"; exit 1; }
shopt -s nullglob
files=(*.fq.gz *.fastq.gz)
if [ ${#files[@]} -eq 0 ]; then
    echo "ERRO: Nenhum arquivo .fq.gz ou .fastq.gz encontrado em $INPUT_DIR!"
    exit 1
fi

# 2. Carregar módulos
echo "Carregando módulos..."
module load FastQC/0.11.8 || {
    echo "ERRO: Não foi possível carregar FastQC/0.11.8"
    exit 1
}

module load MultiQC/1.8 || {
    echo "AVISO: MultiQC/1.8 não disponível - relatório consolidado não será gerado"
}

# 3. Processar cada arquivo com FastQC
echo "Processando ${#files[@]} arquivos..."
for file in "${files[@]}"; do
    echo ">>> Analisando: $file"
    fastqc -t $THREADS -o "$OUTPUT_DIR" "$file"
    
    if [ $? -ne 0 ]; then
        echo "ERRO no processamento de $file"
        exit 1
    fi
done

# 4. Gerar relatório consolidado com MultiQC
if command -v multiqc &>/dev/null; then
    echo "Gerando relatório consolidado MultiQC..."
    cd "$OUTPUT_DIR" || { echo "ERRO: Não foi possível acessar $OUTPUT_DIR"; exit 1; }
    multiqc . --filename multiqc_report.html
    
    if [ -f "multiqc_report.html" ]; then
        echo "Relatório gerado: $OUTPUT_DIR/multiqc_report.html"
    else
        echo "AVISO: Relatório MultiQC não foi gerado"
    fi
fi

# 5. Finalização
echo "=============================================="
echo "Processo concluído em $(date)"
echo "Resultados salvos em: $OUTPUT_DIR"
echo "=============================================="

