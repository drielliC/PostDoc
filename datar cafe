mkdir -p single_copy_alignments_renamed
for f in single_copy_alignments/*.fa; do
    og=$(basename "$f")
    sed 's/>Acos_primary[^ ]*/>Acos/g;
         s/>MARCOL-[^ ]*/>MARCOL/g;
         s/>Palb-[^ ]*/>Palb/g;
         s/>Psta-[^ ]*/>Psta/g;
         s/>RANCOL-[^ ]*/>RANCOL/g;
         s/>Tfas_[^ ]*/>Tfas/g' "$f" > "single_copy_alignments_renamed/$og"
done

