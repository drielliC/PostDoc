python3 - <<'EOF'
import re
mm = M = ins = dele = gaps = 0
mm_f = M_f = 0
cig = re.compile(r'(\d+)([MID])')
with open("Psta_vs_Palb.paf") as f:
    for line in f:
        if "tp:A:P" not in line: continue
        c = line.rstrip("\n").split("\t")
        tags = {t[:2]: t[5:] for t in c[12:]}
        nm = int(tags["NM"])
        m = i = d = g = 0
        for n, op in cig.findall(tags["cg"]):
            n = int(n)
            if op == "M": m += n
            elif op == "I": i += n; g += 1
            else: d += n; g += 1
        snp = nm - i - d                 # NM = mismatches + bases de indel
        mm += snp; M += m; ins += i; dele += d; gaps += g
        if int(c[11]) >= 5 and int(c[10]) >= 10000:   # MAPQ>=5 e bloco>=10 kb
            mm_f += snp; M_f += m
print(f"Colunas alinhadas (M): {M/1e6:.1f} Mb")
print(f"Divergência por SNP (todas primárias):   {100*mm/M:.3f}%")
print(f"Divergência por SNP (MAPQ>=5, >=10 kb):  {100*mm_f/M_f:.3f}%")
print(f"Bases em inserções: {ins/1e6:.1f} Mb | deleções: {dele/1e6:.1f} Mb | nº de gaps: {gaps:,}")
print(f"Indels por kb alinhado: {1000*gaps/M:.2f}")
EOF

