1. CONFIGURAÇÃO INICIAL E PACOTES
r
# Definir mirror do CRAN
options(repos = c(CRAN = "https://cloud.r-project.org"))
Objetivo: Define de qual servidor baixar os pacotes R.

r
# Lista de pacotes necessários
required_packages <- c("methylKit", "ggplot2", "matrixStats", "GenomicRanges")
Objetivo: Lista os pacotes essenciais para a análise.

r
# Função para instalar pacotes se estiverem faltando
install_if_missing <- function(packages) {
  for(pkg in packages) {
    if(!require(pkg, character.only = TRUE, quietly = TRUE)) {
      message("Instalando pacote: ", pkg)
      install.packages(pkg, dependencies = TRUE, repos = "https://cloud.r-project.org")
      library(pkg, character.only = TRUE)
    } else {
      message("Pacote ", pkg, " já está instalado")
    }
  }
}
Objetivo: Função inteligente que verifica e instala automaticamente os pacotes necessários.

2. PREPARAÇÃO DO AMBIENTE
r
# Definir o diretório de trabalho
setwd("~/Pitcairnia/extraction/CpG_context/cov/filtrados_SNP/")
Objetivo: Define onde estão os arquivos de dados.

