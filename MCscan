# Install dependencies
conda install -c conda-forge -c bioconda numpy scipy cython matplotlib scikit-learn

# Install JCVI
pip install jcvi

sudo apt-get install ncbi-blast+

python -c "import jcvi; print('JCVI imported successfully')"
python -c "from jcvi.compara.synteny import MCscan; print('MCscan available')"
____________________________________________________________-
For MCscan to work, we'll need sequences (FASTA format) and coordinates (BED format).

1. Primeiro, explore o arquivo GFF3:
bash
# Ver as primeiras linhas do arquivo
head -n 20 ~/Pitcairnia/reference_genome/Psta-Annotation.gff3
# Ver quais tipos de features existem
grep -v '^#' ~/Pitcairnia/reference_genome/Psta-Annotation.gff3 | cut -f3 | sort | uniq -c
# Ver quais atributos estão disponíveis na nona coluna
grep -v '^#' ~/Pitcairnia/reference_genome/Psta-Annotation.gff3 | head -n 5 | cut -f9 | tr ';' '\n'

2. # Use tipo 'mRNA' e key 'ID' pois os mRNAs têm IDs únicos
python -m jcvi.formats.gff bed --type=mRNA --key=ID ~/Pitcairnia/reference_genome/Psta-Annotation.gff3 -o ~/Pitcairnia/reference_genome/Psta.bed

3.# Converter para BED usando mRNA e ID (mesmo padrão do Psta)
python -m jcvi.formats.gff bed --type=mRNA --key=ID ~/Pitcairnia/reference_genome/Palb-Annotation.gff3 -o ~/Pitcairnia/reference_genome/Palb.bed

