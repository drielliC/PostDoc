#Step 1. FastQC e MultiQc

nano run_quality_check.sh

#!/bin/bash

# Caminhos dos diretórios de entrada e saída
FASTQ_DIR="/home/andreiat/Documents/alunos/driii/dataUNICAMP/methyl"
FASTQC_OUTPUT="/home/andreiat/Documents/alunos/driii/dataUNICAMP/methyl/fastqc"
MULTIQC_OUTPUT="/home/andreiat/Documents/alunos/driii/dataUNICAMP/methyl/multiqc"

# Criar diretórios de saída, se não existirem
mkdir -p "$FASTQC_OUTPUT"
mkdir -p "$MULTIQC_OUTPUT"

# Executar FastQC em todos os arquivos .fastq.gz
echo "Iniciando análise de qualidade com FastQC..."
for file in "$FASTQ_DIR"/*.fastq.gz; do
    echo "Analisando ${file} com FastQC..."
    fastqc -q -o "$FASTQC_OUTPUT" "${file}"
done

# Executar MultiQC para agregar todos os relatórios FastQC
echo "Agregando relatórios com MultiQC..."
multiqc -f -p "$FASTQC_OUTPUT" -o "$MULTIQC_OUTPUT"

echo "Análise de qualidade concluída. Relatório MultiQC disponível em ${MULTIQC_OUTPUT}/multiqc_report.html"

