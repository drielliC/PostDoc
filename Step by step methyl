nano run_bismark_alignment.sh

#!/bin/bash
# Caminhos dos diretórios
TRIMMED_DIR="/home/andreiat/Documents/alunos/driii/dataUNICAMP/methyl/trimmed"
GENOME_DIR="/home/andreiat/Documents/alunos/driii/dataUNICAMP/methyl/reference_genome"
BISMARK_OUTPUT="/home/andreiat/Documents/alunos/driii/dataUNICAMP/methyl/bismark"
mkdir -p "$BISMARK_OUTPUT"
# Loop pelos arquivos R1 para fazer o alinhamento com Bismark
echo "Iniciando o alinhamento com Bismark..."
for file_name in "$TRIMMED_DIR"/*_R1_val_1.fq.gz; do
    # Localiza o arquivo de leitura pareado R2
    file_name_R2="${file_name//_R1_val_1/_R2_val_2}"
    # Verifica se o arquivo R2 existe
    if [[ -f "$file_name_R2" ]]; then
        echo "Alinhando pares: $file_name e $file_name_R2..."
        # Executa o alinhamento com Bismark
        bismark --genome "$GENOME_DIR" -1 "$file_name" -2 "$file_name_R2" -o "$BISMARK_OUTPUT"
    else
        echo "Par não encontrado para $file_name"
    fi
done

echo "Alinhamento com Bismark concluído. Resultados estão em $BISMARK_OUTPUT."

