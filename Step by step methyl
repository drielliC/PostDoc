Step 2. Trim the adapters and low quality sequence reads

Adapter sequences should be removed from reads because they interfere with downstream analyses, such as alignment of reads to a reference.
In the FastQC report, the adapter content plot shows the percentage of reads (y-axis), which has an adapter starting at a particular position along a read (x-axis). 
And if the reads were fragmentaed to lower than than the target molecule length, high propotion of reads with adapters will be observed (right).

#!/bin/bash

# Caminhos dos diretórios de entrada e saída
FASTQ_DIR="/home/andreiat/Documents/alunos/driii/dataUNICAMP/methyl"
TRIMMED_OUTPUT="/home/andreiat/Documents/alunos/driii/dataUNICAMP/methyl/trimmed"
mkdir -p "$TRIMMED_OUTPUT"

# Executar Trim Galore em todos os arquivos de leitura pareados
echo "Iniciando a trimagem com Trim Galore..."
for file1 in "$FASTQ_DIR"/*_1.fastq.gz; do
    # Identifica o arquivo de leitura pareado R2
    file2="${file1/_1.fastq.gz/_2.fastq.gz}"

    # Verifica se o arquivo R2 correspondente existe
    if [[ -f "$file2" ]]; then
        echo "Processando pares: $file1 e $file2 com Trim Galore..."

        # Executa o Trim Galore com 4 threads, modo pareado, com FastQC
        trim_galore -j 4 --paired --illumina -o "$TRIMMED_OUTPUT" --fastqc "$file1" "$file2"
    else
        echo "Par não encontrado para $file1"
    fi
done

echo "Processo de trimagem concluído. Arquivos trimados e relatórios FastQC estão em $TRIMMED_OUTPUT."

